{
  "name": "tierratrace-website",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:preview": "vite build --mode singlefile",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "start": "vite --open"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0"
  },
  "description": "TierraTrace marketing site — homepage + the six Platform product pages (Passport, Trace, Carbon, Verify, Insights, Connect) in one connected app.",
  "engines": {
    "node": ">=20"
